---
import SweepDemo from '../components/SweepDemo.astro';

// A real three-step sequence, so the steps are numbered.
const steps = [
  {
    title: 'Point it at your projects',
    text: 'Add the folders where your code lives. Sweepkey only offers a folder when a marker file proves what it is: target/ next to Cargo.toml, build/ next to pubspec.yaml or build.gradle.',
  },
  {
    title: 'Review the dry run',
    text: 'Every folder is listed with its size, its risk level and the command that rebuilds it. Folders that git tracks are skipped, and nothing is deleted until you confirm.',
  },
  {
    title: 'Sweep, keys first',
    text: 'Your .env files, keystores and other files git does not have are copied into a vault, then the rebuildable folders are removed or moved to the Trash.',
  },
];
---

<section class="section" id="how" aria-labelledby="how-title">
  <div class="page how">
    <div class="how__copy">
      <h2 id="how-title">Try it: tick, sweep, keep the keys.</h2>
      <p class="lede">
        This demo disk works like the app. Click a folder to keep it, then sweep the rest. The secret files go to
        the vault first.
      </p>
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li>
              <span class="steps__number" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <SweepDemo />
  </div>
</section>

<style>
  .how {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .how__copy {
    display: grid;
    gap: var(--space-5);
  }

  .how__copy .lede {
    font-size: var(--step-0);
  }

  .steps {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  .steps__number {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--bg-sunk);
    border: 1px solid var(--line);
    font: 600 0.95rem/1 var(--font-text);
    color: var(--accent);
  }

  .steps h3 {
    margin-bottom: var(--space-1);
  }

  .steps p {
    color: var(--ink-muted);
  }

  @media (max-width: 980px) {
    .how {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
