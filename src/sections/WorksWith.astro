---
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { worksWith } from '../data/logos';
---

<section class="works" aria-labelledby="works-title">
  <div class="page works__head">
    <div>
      <h2 id="works-title">Finds rebuildable folders across 20+ ecosystems</h2>
      <p>
        JavaScript and TypeScript, Python, Swift and Xcode, Flutter, Android and Gradle, Rust, Go, .NET, C/C++,
        Elixir, Haskell, Ruby, PHP, Zig, Scala, Bazel, Terraform, Unity, Unreal, and the caches of the tools around
        them.
      </p>
    </div>
    <button type="button" class="works__pause" data-marquee-toggle aria-pressed="false">
      <Icon name="pause" class="works__icon-pause" /><Icon name="play" class="works__icon-play" />
      <span data-marquee-label>Pause logos</span>
    </button>
  </div>
  <div class="marquee" data-marquee>
    <ul class="marquee__track">
      {
        [...worksWith, ...worksWith].map((logo, i) => (
          <li aria-hidden={i >= worksWith.length ? 'true' : undefined}>
            <Logo id={logo.id} size={28} />
            <span>{logo.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .works {
    padding-block: var(--space-8);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .works__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .works h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-3);
  }

  .works__head p {
    color: var(--ink-muted);
    max-width: 52em;
  }

  .works__pause {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--ink-muted);
    font: 500 0.85rem/1 var(--font-text);
    cursor: pointer;
  }

  .works__pause :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .works__pause[aria-pressed='false'] :global(.works__icon-play),
  .works__pause[aria-pressed='true'] :global(.works__icon-pause) {
    display: none;
  }

  .marquee {
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    gap: var(--space-6);
    width: max-content;
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
    animation: marquee 70s linear infinite;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track,
  .marquee[data-paused] .marquee__track {
    animation-play-state: paused;
  }

  .marquee li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - var(--space-6) / 2));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      padding-inline: max(16px, (100% - 1180px) / 2);
    }

    .marquee li[aria-hidden='true'],
    .works__pause {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .works__head {
      flex-direction: column;
      align-items: start;
    }
  }
</style>

<script>
  const marquee = document.querySelector<HTMLElement>('[data-marquee]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  const label = document.querySelector<HTMLElement>('[data-marquee-label]');
  toggle?.addEventListener('click', () => {
    const paused = toggle.getAttribute('aria-pressed') !== 'true';
    toggle.setAttribute('aria-pressed', String(paused));
    marquee?.toggleAttribute('data-paused', paused);
    if (label) label.textContent = paused ? 'Play logos' : 'Pause logos';
  });
</script>
