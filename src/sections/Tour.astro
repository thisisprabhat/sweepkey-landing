---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import projectsDark from '../assets/screenshots/dark/projects-inspector.png';
import projectsLight from '../assets/screenshots/light/projects-inspector.png';
import cachesDark from '../assets/screenshots/dark/caches.png';
import cachesLight from '../assets/screenshots/light/caches.png';
import vaultDark from '../assets/screenshots/dark/vault-findings.png';
import vaultLight from '../assets/screenshots/light/vault-findings.png';
import historyDark from '../assets/screenshots/dark/history.png';
import historyLight from '../assets/screenshots/light/history.png';
import rulesDark from '../assets/screenshots/dark/rules.png';
import rulesLight from '../assets/screenshots/light/rules.png';
import recipesDark from '../assets/screenshots/dark/recipes.png';
import recipesLight from '../assets/screenshots/light/recipes.png';

interface Tab {
  id: string;
  label: string;
  title: string;
  text: string;
  points: string[];
  dark: ImageMetadata;
  light?: ImageMetadata;
  alt: string;
}

// Copy from Docs/03 (S5), checked against the app.
const tabs: Tab[] = [
  {
    id: 'projects',
    label: 'Projects',
    title: 'Every project, sized up',
    text: "Add your project folders once. Sweepkey finds each project's rebuildable folders, shows how big they are, when you last worked on it, and the command that brings them back.",
    points: [
      'Results stream in live with a running total, and rescans only redo changed folders.',
      'Git details at a glance: branch, uncommitted changes, unpushed commits, stashes.',
      'Projects untouched for 30 days are flagged as stale, so they are safe first picks.',
    ],
    dark: projectsDark,
    light: projectsLight,
    alt: 'Projects list with framework logos, last activity, reclaimable size and risk badges, and the inspector showing a project\'s git branch, uncommitted changes and unpushed commits.',
  },
  {
    id: 'caches',
    label: 'Caches',
    title: 'Developer caches, grouped',
    text: 'The caches your tools leave outside projects, grouped by tool. Where a tool has its own cleanup command, Sweepkey runs that instead of deleting files by hand.',
    points: [
      'Xcode: DerivedData, Archives, device support, unavailable simulators.',
      'Package and version managers: npm, pnpm, Yarn, pip, uv, Cargo, Go, Maven, CocoaPods, nvm, pyenv, rustup and more.',
      'Docker, OrbStack and Colima, IDE caches, and opt-in AI model caches.',
    ],
    dark: cachesDark,
    light: cachesLight,
    alt: 'Caches grouped by Xcode, Android, package managers, version managers and containers, with sizes.',
  },
  {
    id: 'vault',
    label: 'Vault',
    title: 'Keep the keys',
    text: "Before you clean, collect the files git doesn't have and can't rebuild: .env files, keystores, certificates, cloud credentials. Export them as a folder, a zip or an encrypted disk image.",
    points: [
      'Git-aware: finds ignored and untracked files that match secret patterns.',
      "Keeps each project's folder layout, plus a manifest with checksums.",
      'Restore to the original paths, or by git remote after a fresh clone on a new Mac.',
    ],
    dark: vaultDark,
    light: vaultLight,
    alt: 'Vault findings grouped by project, each with its framework logo, all selected for export.',
  },
  {
    id: 'history',
    label: 'History',
    title: 'Every clean, on record',
    text: 'Each clean is journaled: what was removed, where, how big, and how. See your lifetime space reclaimed and the trend over time.',
    points: [
      'Runs that moved items to the Trash can be undone with Put Back.',
      'After a clean, affected projects are rescanned and you see free space before and after.',
      'A menu bar extra shows free and reclaimable space at a glance.',
    ],
    dark: historyDark,
    light: historyLight,
    alt: 'History with total space freed, number of cleanups, a freed-over-time chart and cleanups grouped by month.',
  },
  {
    id: 'rules',
    label: 'Rules',
    title: 'Rules are just JSON',
    text: 'What counts as rebuildable is data, not code. Turn rules on or off, or add your own with a marker file, a target and a risk level.',
    points: [
      'A rule only matches when its marker file exists, so build/ is never touched in the wrong project.',
      'Ambiguous folders like dist, vendor and env are off by default.',
      'Exclude paths, add a .sweepkeyignore, or pin a project so it is never offered.',
    ],
    dark: rulesDark,
    light: rulesLight,
    alt: 'Rules screen with a "How rules work" explanation and rule switches grouped by ecosystem.',
  },
  {
    id: 'recipes',
    label: 'Recipes',
    title: 'Guided jobs',
    text: 'Recipes combine cleaning and the vault into step-by-step jobs. Each one plans everything first and shows you the result before anything is deleted.',
    points: [
      'Free Up Space: ask for a number of GB and review the safest plan.',
      'Archive a Project: save secrets, clean, optionally zip.',
      'Move to a New Mac: a bundle with your vault, your repo list and a restore script.',
    ],
    dark: recipesDark,
    light: recipesLight,
    alt: 'Recipes screen with three recipe cards and the Free Up Space planner.',
  },
];

const widths = [640, 1024, 1600];
const sizes = '(max-width: 980px) 92vw, 760px';
---

<section class="section section--band" id="features" aria-labelledby="features-title">
  <div class="page">
    <div class="section-head">
      <h2 id="features-title">One window for every project, cache and secret.</h2>
    </div>
    <div class="tour" data-tabs>
      <div class="tour__list" role="tablist" aria-label="App features" aria-orientation="vertical">
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`tour-${tab.id}`}
              aria-controls={`tour-panel-${tab.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="tour__tab-label">{tab.label}</span>
              <span class="tour__tab-title">{tab.title}</span>
            </button>
          ))
        }
      </div>
      {
        tabs.map((tab, i) => (
          <div
            class="tour__panel"
            role="tabpanel"
            id={`tour-panel-${tab.id}`}
            aria-labelledby={`tour-${tab.id}`}
            tabindex="0"
            hidden={i !== 0}
          >
            <div class="window">
              {tab.light ? (
                <>
                  <Image class="only-light" src={tab.light} alt={tab.alt} widths={widths} sizes={sizes} loading={i === 0 ? 'eager' : 'lazy'} />
                  <Image class="only-dark" src={tab.dark} alt={tab.alt} widths={widths} sizes={sizes} loading="lazy" />
                </>
              ) : (
                <Image src={tab.dark} alt={tab.alt} widths={widths} sizes={sizes} loading="lazy" />
              )}
            </div>
            <div class="tour__copy">
              <h3>{tab.title}</h3>
              <p>{tab.text}</p>
              <ul>
                {tab.points.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tour {
    display: grid;
    grid-template-columns: minmax(200px, 0.32fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .tour__list {
    display: grid;
    gap: var(--space-1);
    position: sticky;
    top: 6rem;
  }

  [role='tab'] {
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem 1rem;
    border: 0;
    border-left: 2px solid var(--line);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
    background: none;
    color: var(--ink-muted);
    text-align: left;
    cursor: pointer;
  }

  [role='tab']:hover {
    color: var(--ink);
    background: var(--bg-raised);
  }

  [role='tab'][aria-selected='true'] {
    border-left-color: var(--accent);
    background: var(--bg-raised);
    color: var(--ink);
  }

  .tour__tab-label {
    font: 700 1.1rem/1.2 var(--font-display);
  }

  .tour__tab-title {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .tour__panel {
    display: grid;
    gap: var(--space-6);
  }

  .tour__panel:focus-visible {
    outline-offset: 8px;
  }

  .tour__copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3) var(--space-7);
  }

  .tour__copy h3 {
    grid-column: 1 / -1;
    font-size: var(--step-2);
  }

  .tour__copy p {
    color: var(--ink-muted);
  }

  .tour__copy ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-muted);
  }

  .tour__copy li::marker {
    color: var(--accent);
  }

  @media (max-width: 980px) {
    .tour {
      grid-template-columns: minmax(0, 1fr);
    }

    .tour__list {
      position: static;
      display: flex;
      overflow-x: auto;
      gap: var(--space-2);
      padding-bottom: var(--space-2);
    }

    [role='tab'] {
      flex: none;
      border-left: 0;
      border-bottom: 2px solid var(--line);
      border-radius: var(--radius-m) var(--radius-m) 0 0;
    }

    [role='tab'][aria-selected='true'] {
      border-bottom-color: var(--accent);
    }

    .tour__tab-title {
      display: none;
    }

    .tour__copy {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  // WAI-ARIA tabs: arrows/Home/End move focus and select (automatic activation); #tour-<id> opens a tab.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = true) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1,
        };
        if (!(event.key in keys)) return;
        event.preventDefault();
        select(tabs[(keys[event.key] + tabs.length) % tabs.length]);
      });
    });
    const fromHash = tabs.find((t) => `#${t.id}` === location.hash);
    if (fromHash) select(fromHash, false);
  }
</script>
