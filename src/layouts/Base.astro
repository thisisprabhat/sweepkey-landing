---
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { DESCRIPTION, OWNER, REPO_URL, SITE_NAME, SITE_URL, TAGLINE } from '../data/site';
import { release } from '../data/release';
import { faq } from '../data/faq';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: boolean;
  noindex?: boolean;
}

const { title = `${SITE_NAME}: ${TAGLINE}`, description = DESCRIPTION, jsonLd = true, noindex = false } = Astro.props;
const ogAlt = "Sweepkey: Sweep the rebuildable. Keep the keys. Shown next to the app's Dashboard.";
const canonical = new URL(Astro.url.pathname === '/index' ? '/' : Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og-image.png', SITE_URL).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, url: SITE_URL, name: SITE_NAME, description },
    {
      '@type': 'SoftwareApplication',
      name: SITE_NAME,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS 26 or later',
      description,
      url: SITE_URL,
      image: ogImage,
      screenshot: ogImage,
      author: { '@type': 'Person', name: 'Prabhat Kumar' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://opensource.org/licenses/MIT',
      ...(release && {
        softwareVersion: release.version,
        downloadUrl: release.githubUrl,
        fileSize: release.sizeLabel,
        datePublished: release.date,
        releaseNotes: release.notesUrl,
      }),
    },
    {
      '@type': 'SoftwareSourceCode',
      name: SITE_NAME,
      codeRepository: REPO_URL,
      programmingLanguage: 'Swift',
      license: 'https://opensource.org/licenses/MIT',
      author: { '@type': 'Organization', name: OWNER, url: `https://github.com/${OWNER}` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="author" content="Prabhat Kumar" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1c1c1e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <script is:inline>
      // Pick the theme before first paint: saved choice, else the system setting.
      try {
        const saved = localStorage.getItem('sweepkey-theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <p id="copy-status" class="visually-hidden" aria-live="polite"></p>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-m);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
