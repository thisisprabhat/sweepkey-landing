---
// The interactive "Sweep" demo: a treemap of a fictional ~/Projects. Click tiles to keep them,
// press Sweep, and the secrets move into the vault before the folders are cleared.
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { demoLayout, demoTotalBytes } from '../data/demo';
import { formatSize } from '../data/release';

const pos = (r: { x: number; y: number; w: number; h: number }) =>
  `left:${r.x.toFixed(3)}%;top:${r.y.toFixed(3)}%;width:${r.w.toFixed(3)}%;height:${r.h.toFixed(3)}%`;
const gb = (bytes: number) => `${(bytes / 1e9).toFixed(1)} GB`;
---

<div class="disk" data-disk aria-labelledby="disk-title" role="group">
  <div class="disk__head">
    <div>
      <h2 id="disk-title" class="disk__title">~/Projects</h2>
      <p class="disk__hint">A demo disk. Click a folder to keep it, then sweep.</p>
    </div>
    <p class="disk__total"><output data-selected>{gb(demoTotalBytes)}</output> to sweep</p>
  </div>

  <div class="disk__map" data-map>
    {
      demoLayout.map((project) => (
        <div class="disk__project" style={pos(project.rect)}>
          <span class="disk__project-name">
            <Logo id={project.ecosystem} size={14} />
            {project.name}
          </span>
          {project.secrets.length > 0 && (
            <span class="disk__secrets">
              {project.secrets.map((secret) => (
                <span class="secret" data-secret={secret.id} data-name={secret.name} title={`${secret.name}: ${secret.why}`}>
                  <Icon name="key" label={`${secret.name}, ${secret.why}`} />
                </span>
              ))}
            </span>
          )}
        </div>
      ))
    }
    {
      demoLayout.flatMap((project) =>
        project.tiles.map((tile) => (
          <button
            type="button"
            class:list={['tile', { 'tile--tiny': tile.rect.w < 9 || tile.rect.h < 11 }]}
            style={`${pos(tile.rect)};--x:${tile.rect.x.toFixed(1)}`}
            aria-pressed="true"
            data-tile
            data-bytes={tile.bytes}
            data-regenerate={tile.regenerate}
            aria-label={`${project.name}/${tile.name}, ${formatSize(tile.bytes)}, rebuild with ${tile.regenerate}`}
            title={`Rebuild with: ${tile.regenerate}`}
          >
            <span class="tile__name">{tile.name}</span>
            <span class="tile__size">{formatSize(tile.bytes)}</span>
            <span class="tile__state" aria-hidden="true" />
          </button>
        )),
      )
    }
    <div class="disk__stroke" aria-hidden="true"></div>
  </div>

  <div class="disk__foot">
    <div class="disk__freed">
      <span class="disk__label">Freed</span>
      <output data-freed>0 GB</output>
    </div>
    <div class="disk__vault">
      <span class="disk__label"><Icon name="shield" /> Vault</span>
      <ul data-vault><li class="disk__empty">Nothing yet</li></ul>
    </div>
    <div class="disk__actions">
      <button type="button" class="button button--sweep" data-sweep>
        <Icon name="sweep" /><span data-sweep-label>Sweep {gb(demoTotalBytes)}</span>
      </button>
      <button type="button" class="button" data-reset hidden><Icon name="undo" />Reset</button>
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-status></p>
  <noscript><p class="disk__noscript">The demo needs JavaScript. In the app you review every folder, its size and the command that rebuilds it, then confirm.</p></noscript>
</div>

<style>
  .disk {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: clamp(14px, 2vw, 22px);
    border-radius: var(--radius-l);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .disk__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .disk__title {
    font: 600 1.05rem/1.2 var(--font-mono);
    letter-spacing: 0;
  }

  .disk__hint {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .disk__total {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .disk__total output {
    font: 700 1.4rem/1 var(--font-display);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .disk__map {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-m);
    background: var(--bg-sunk);
    overflow: hidden;
    container-type: inline-size;
  }

  .disk__project {
    position: absolute;
    border-radius: 9px;
    background: color-mix(in srgb, var(--indigo-deep) 22%, transparent);
  }

  .disk__project-name {
    position: absolute;
    left: 0.45rem;
    top: 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    max-width: calc(100% - 3.5rem);
    font: 600 clamp(0.62rem, 1.7cqi, 0.78rem) / 1.3 var(--font-mono);
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .disk__secrets {
    position: absolute;
    right: 0.3rem;
    top: 0.15rem;
    display: flex;
    gap: 0.2rem;
  }

  .secret {
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--mint);
    color: var(--mint-ink);
  }

  .secret :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }

  .tile {
    position: absolute;
    display: grid;
    align-content: end;
    gap: 0.1rem;
    padding: 0.4rem 0.5rem;
    margin: 0;
    border: 2px solid transparent;
    border-radius: 7px;
    background: var(--tile);
    background-clip: padding-box;
    color: var(--ink);
    text-align: left;
    overflow: hidden;
    cursor: pointer;
    transition:
      background-color 0.2s,
      opacity 0.35s var(--ease-out),
      transform 0.35s var(--ease-out),
      border-color 0.2s;
  }

  .tile:hover {
    background-color: var(--tile-hover);
  }

  .tile__name {
    font: 600 clamp(0.62rem, 1.9cqi, 0.9rem) / 1.15 var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tile__size {
    font-size: clamp(0.6rem, 1.6cqi, 0.78rem);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Too small for a label: the name stays in the tooltip and the accessible name. */
  .tile--tiny .tile__name,
  .tile--tiny .tile__size {
    display: none;
  }

  /* Kept (not selected): a hatched tile that the sweep leaves alone */
  .tile[aria-pressed='false'] {
    background-image: repeating-linear-gradient(-45deg, transparent 0 6px, var(--line) 6px 7px);
    color: var(--ink-muted);
  }

  .tile[aria-pressed='false'] .tile__state::after {
    content: 'kept';
    position: absolute;
    top: 0.35rem;
    right: 0.45rem;
    font: 600 0.62rem/1 var(--font-text);
    color: var(--ink-faint);
  }

  /* Swept: the tile empties out where the stroke passed */
  .tile.is-gone {
    background: transparent;
    border: 2px dashed var(--line-strong);
    color: var(--ink-faint);
    transition-delay: calc(var(--x) * 6ms);
    cursor: default;
  }

  .tile.is-gone .tile__size {
    color: var(--mint);
  }

  .disk__stroke {
    position: absolute;
    inset: -10% -40%;
    background: linear-gradient(100deg, transparent 38%, color-mix(in srgb, var(--mint) 55%, transparent) 50%, transparent 62%);
    transform: translateX(-100%);
    pointer-events: none;
  }

  .disk.is-sweeping .disk__stroke {
    animation: sweep 0.95s var(--ease-out) forwards;
  }

  @keyframes sweep {
    to {
      transform: translateX(100%);
    }
  }

  .disk__foot {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-5);
  }

  .disk__label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .disk__label :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .disk__freed {
    display: grid;
  }

  .disk__freed output {
    font: 750 1.6rem/1.1 var(--font-display);
    color: var(--mint);
    font-variant-numeric: tabular-nums;
  }

  .disk__vault ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.2rem 0 0;
    padding: 0;
    list-style: none;
    min-height: 1.6rem;
  }

  /* Vault items are created by the script, so they need :global to get these styles. */
  .disk__vault :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.55rem 0.15rem 0.2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--mint) 16%, transparent);
    font: 500 0.75rem/1.4 var(--font-mono);
  }

  .disk__vault :global(li.disk__empty) {
    background: none;
    padding-left: 0;
    color: var(--ink-faint);
    font-family: var(--font-text);
  }

  .disk__actions {
    display: flex;
    gap: var(--space-2);
  }

  .disk__noscript {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 560px) {
    .disk__foot {
      grid-template-columns: 1fr 1fr;
    }

    .disk__actions {
      grid-column: 1 / -1;
    }

    .disk__actions .button {
      flex: 1;
    }
  }
</style>

<script>
  const disk = document.querySelector<HTMLElement>('[data-disk]');
  if (disk) setUpDisk(disk);

  function setUpDisk(root: HTMLElement) {
    const tiles = [...root.querySelectorAll<HTMLButtonElement>('[data-tile]')];
    const selectedOut = root.querySelector<HTMLOutputElement>('[data-selected]')!;
    const freedOut = root.querySelector<HTMLOutputElement>('[data-freed]')!;
    const sweepButton = root.querySelector<HTMLButtonElement>('[data-sweep]')!;
    const sweepLabel = root.querySelector<HTMLElement>('[data-sweep-label]')!;
    const resetButton = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const vault = root.querySelector<HTMLUListElement>('[data-vault]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let swept = false;

    const gb = (bytes: number) => `${(bytes / 1e9).toFixed(1)} GB`;
    const selected = () => tiles.filter((t) => t.getAttribute('aria-pressed') === 'true');
    const selectedBytes = () => selected().reduce((sum, t) => sum + Number(t.dataset.bytes), 0);

    function refresh() {
      const bytes = selectedBytes();
      selectedOut.textContent = gb(bytes);
      sweepLabel.textContent = bytes > 0 ? `Sweep ${gb(bytes)}` : 'Nothing selected';
      sweepButton.disabled = swept || bytes === 0;
    }

    for (const tile of tiles) {
      tile.addEventListener('click', () => {
        if (swept) return;
        tile.setAttribute('aria-pressed', tile.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        refresh();
      });
    }

    // The running count-up, so Reset can stop it before it overwrites "0 GB".
    let countFrame = 0;

    function countUp(target: number) {
      cancelAnimationFrame(countFrame);
      if (reduced.matches) {
        freedOut.textContent = gb(target);
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 900);
        freedOut.textContent = gb(target * (1 - (1 - t) ** 3));
        if (t < 1) countFrame = requestAnimationFrame(step);
      };
      countFrame = requestAnimationFrame(step);
    }

    // Secrets travel from their project into the vault (FLIP), so the "keep the keys" half is visible.
    function collectSecrets() {
      const secrets = [...root.querySelectorAll<HTMLElement>('[data-secret]')];
      vault.replaceChildren();
      for (const secret of secrets) {
        const from = secret.getBoundingClientRect();
        const item = document.createElement('li');
        const icon = secret.cloneNode(true) as HTMLElement;
        icon.removeAttribute('title');
        icon.querySelector('svg')?.setAttribute('aria-hidden', 'true');
        icon.querySelector('svg')?.removeAttribute('aria-label');
        item.append(icon, secret.dataset.name ?? '');
        vault.append(item);
        secret.style.visibility = 'hidden';
        if (reduced.matches) continue;
        const to = icon.getBoundingClientRect();
        icon.animate(
          [{ transform: `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(1.15)` }, { transform: 'none' }],
          { duration: 700, easing: 'cubic-bezier(.2,.8,.2,1)' },
        );
      }
      return secrets.length;
    }

    sweepButton.addEventListener('click', () => {
      const chosen = selected();
      if (swept || chosen.length === 0) return;
      swept = true;
      const bytes = selectedBytes();
      refresh();
      root.classList.add('is-sweeping');
      // Secrets go to the vault first, as in the app ("vault before clean").
      const kept = collectSecrets();
      for (const tile of chosen) tile.classList.add('is-gone');
      countUp(bytes);
      status.textContent = `Freed up to ${gb(bytes)}. ${kept} secret files kept in the vault. Rebuild any time with npm install, cargo build or flutter pub get.`;
      sweepLabel.textContent = 'Swept';
      resetButton.hidden = false;
    });

    resetButton.addEventListener('click', () => {
      cancelAnimationFrame(countFrame);
      swept = false;
      root.classList.remove('is-sweeping');
      for (const tile of tiles) {
        tile.classList.remove('is-gone');
        tile.setAttribute('aria-pressed', 'true');
      }
      for (const secret of root.querySelectorAll<HTMLElement>('[data-secret]')) secret.style.visibility = '';
      vault.innerHTML = '<li class="disk__empty">Nothing yet</li>';
      freedOut.textContent = '0 GB';
      resetButton.hidden = true;
      status.textContent = 'Demo reset.';
      refresh();
      sweepButton.focus();
    });

    refresh();
  }
</script>
